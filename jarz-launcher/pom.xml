<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.jarz-streaming</groupId>
        <artifactId>jarz-parent</artifactId>
        <version>2.1.14-SNAPSHOT</version>
    </parent>

    <artifactId>jarz-launcher</artifactId>
    <name>JARZ Universal Launcher</name>
    <description>Universal launcher for JARZ applications with auto-discovery and multi-ClassLoader support</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Core JARZ functionality -->
        <dependency>
            <groupId>net.jarz-streaming</groupId>
            <artifactId>jarz-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- S3 streaming support -->
        <dependency>
            <groupId>net.jarz-streaming</groupId>
            <artifactId>jarz-s3</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- CDN streaming support -->
        <dependency>
            <groupId>net.jarz-streaming</groupId>
            <artifactId>jarz-cdn</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- JSON configuration support -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.21.1</version>
            <optional>true</optional>
        </dependency>

        <!-- YAML configuration support -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>2.21.0</version>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Shade plugin to create executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>jarz-launcher</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>net.jarz.streaming.launcher.UniversalJarzLauncher</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
