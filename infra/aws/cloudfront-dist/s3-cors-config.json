{
  "CORSRules": [
    {
      "AllowedHeaders": ["Range", "If-Range", "If-Modified-Since", "Authorization"],
      "AllowedMethods": ["GET", "HEAD"],
      "AllowedOrigins": ["*"],
      "ExposeHeaders": ["Content-Range", "Content-Length", "Accept-Ranges", "ETag", "Last-Modified"],
      "MaxAgeSeconds": 3600
    }
  ]
}
